SELLERCHAMP_TOKEN=your_token_here
SELLERCHAMP_BASE_URL=https://app.sellerchamp.com
PORT=3000
# On Render with a persistent disk mounted at /var/data, set this to /var/data
DATA_DIR=./data
# Default qualifying SellerChamp order status
QUALIFYING_ORDER_STATUS=unshipped
# Optional app PIN. Leave blank to disable.
APP_PIN=

ORDER_LOOKBACK_DAYS=30
DELETE_BATCH_PIN=8880
